[Unit]
Description=Aztibase Network Node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aztibase
Group=aztibase
ExecStart=/usr/local/bin/aztibase --config /etc/aztibase/node.toml --testnet --metrics
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

WorkingDirectory=/var/lib/aztibase
StateDirectory=aztibase
ConfigurationDirectory=aztibase

Environment=RUST_LOG=info

[Install]
WantedBy=multi-user.target
